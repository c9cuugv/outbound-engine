# Secrets — never commit
.env
*.env.local
*.env.production
secrets/
proxy.token

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Test artifacts — generated, never committed
frontend/playwright-report/
frontend/test-results/
frontend/playwright-results.json
frontend/playwright-results.xml
playwright-transform-cache-*/
# E2E specs generate these; they must be cleaned up by the specs themselves
**/temp_lead_*.csv

# Docker volumes & overrides
docker-compose.override.yml

# OS
**/.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Agent / tooling scratch
.gemini/
.superpowers/
.planning/
.playwright-mcp/
.hermes/
.kiro/
.claude/worktrees/

# Local Claude Code plugin tooling (context-mode/headroom) — not part of this app;
# app dependencies live in backend/ and frontend/, not the repo root.
/package.json
/package-lock.json

# Generated audit reports — ignored at root, but kept once archived under docs/audits/
/PERF-AUDIT-*.md
/AUDIT-SPEC.md
/council-report-*.html
/council-transcript-*.md
/security-council-report-summary.md
/security-audit-report.md
/health_check.txt
# The 12 audit reports already archived under docs/audits/ stay tracked, but a
# daily cron keeps dropping new PERF-AUDIT files there — ignore those so they
# don't clutter git status. (Ignoring an already-tracked file is a no-op.)
docs/audits/PERF-AUDIT-*.md
